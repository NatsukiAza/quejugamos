# https://steamcommunity.com/dev/apikey — the domain can be localhost
STEAM_API_KEY=

# Long random string used to sign the session cookie. At least 16 characters.
SESSION_SECRET=

# Upstash Redis REST credentials. Rooms expire; this is not a user database.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public origin, no trailing path. OpenID return_to must match this host.
NEXT_PUBLIC_APP_URL=http://localhost:3000
